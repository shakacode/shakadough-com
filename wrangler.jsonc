{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shakadough-com",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    // The repo root is the asset directory; .assetsignore whitelists public files.
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
